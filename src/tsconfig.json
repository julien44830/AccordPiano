{
    // Hérite des options recommandées par Next
    "extends": "next/tsconfig.json",

    "compilerOptions": {
        // --- Options clés pour Next ---
        "jsx": "preserve", // // Laisse Next/SWC gérer le JSX
        "moduleResolution": "bundler", // // Résolution moderne pour ESM/TS

        // --- Rigueur & DX ---
        "strict": true, // // Mode strict recommandé
        "noEmit": true, // // On ne génère pas de JS via tsc (Next s'en charge)
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,

        // --- Aliases pratiques si tu utilises /src ---
        // // Permet d'importer depuis "@/..." au lieu de chemins relatifs
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        }
    },

    // // Important : couvre les fichiers TS/TSX et types générés par Next
    "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
    "exclude": ["node_modules"]
}
